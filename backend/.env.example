# Configuración del Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=electricos_db
DB_USER=postgres
DB_PASSWORD=postgres_password_local

# Autenticación JWT
JWT_SECRET=super_secret_jwt_key_local_development_change_in_production_32chars!
JWT_EXPIRES_IN=24h
