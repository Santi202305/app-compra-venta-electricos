# ==========================================
# Configuración Global de Variables de Entorno
# ==========================================
# Copie este archivo a .env tanto en la raíz como en /backend y /frontend según aplique.

# Backend (Node.js / Express)
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=electricos_db
DB_USER=postgres
DB_PASSWORD=postgres_password_local

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_local_development_change_in_production_32chars!
JWT_EXPIRES_IN=24h

# Frontend (Flutter)
API_BASE_URL=http://localhost:3000/api/v1
